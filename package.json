{
  "name": "tunesocial-monorepo",
  "version": "1.0.0",
  "description": "Simple monorepo for TuneSocial",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start:backend": "pnpm --filter @tunesocial/backend start:dev",
    "start:frontend": "pnpm --filter @tunesocial/frontend dev",
    "build:all": "pnpm --filter ./shared/** build && pnpm --filter ./backend/** build && pnpm --filter ./frontend/** build",
    "lint:all": "pnpm --filter \"*\" lint",
    "test:all": "pnpm --filter \"*\" test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.24.0"
}
